---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
const albums = [
  ['Viitasen Piia', 'Ihmisen aika', '7muyvm7DBm5sZHG1SvKQVI'],
  ['Viitasen Piia', 'Meidän jälkeemme hiljaisuus', '2Arc4SfxeDXejMQwJvqLny'],
  ['Viitasen Piia', 'Laulumaa', '7eLbKis7lA11gChLlVRygz'],
  ['Project Vainiolla Ensemble', 'Suruvesi', '48zX6BwkiCQKFCATXb7C1H'],
  ['Sibelius Academy Folk Big Band', 'FBB', '2EIsTuyliIW8PH8ZpB3lpX'],
];
---
<Base title="Music & Store" description="Ikivirta, the debut album by Sarah Palu: listen on streaming services or buy on Bandcamp. Film and media music, and ensemble recordings.">
  <section class="section wrap">
    <h2 class="center spaced">Ikivirta | Everflow</h2>
    <p class="center spaced" style="font-size:.85rem;margin-bottom:3rem">Sarah Palu's debut album</p>

    <div class="two-col">
      <div>
        <div class="spotify">
          <iframe title="Ikivirta on Spotify" src="https://open.spotify.com/embed/album/0unvuC1MRxEBhXR5yQo9Ir?utm_source=generator&theme=0" height="380" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>
        <p style="margin-top:1.5rem;display:flex;gap:12px;flex-wrap:wrap">
          <a class="btn" href="https://snd.click/sarahpalu3?embed=1" rel="noopener">Listen on streaming services</a>
          <a class="btn" href="https://sarahpalu.bandcamp.com/releases" rel="noopener">Buy on Bandcamp</a>
        </p>
      </div>
      <div class="justify" lang="fi">
        <p><span class="stars">★★★★★</span> “Ikivirta on samaan aikaan vavahduttavan elokuvamaiselta kuulostava äänitaideteos, kokoelma pieniä, kansanmusiikkimaisia hetkiä, sekä moderni elektronisesti maustettua musiikkia esittelevä albumi. Kannel ja jouhikko ohjaavat ajatuksia menneisiin aikoihin, mutta mennyt ei ole mikään pölyinen museo, vaan elinvoimainen luovuuden lähde, jossa mikään ei ole kuollutta.</p>
        <p>Albumin avaa ja sulkee pitkä instrumentaaliraita, joilla aaltomainen poljento luo elämän suurta pyörää muistuttavan kierron. Näissä hetkissä, kuten koko levyssä, mennyt ja nykyinen löytävät toisistaan rakastettavan kumppanin ainesten sekoittuessa toisiinsa. Pääosin akustiset soittimet värittyvät sähköisistä silauksista, tasapainon ollessa jatkuvasti optimaalinen. Meri ja kärpänen voi näin nojata huoletta elektroniseen maalailuun, sillä pintaan nouseva kannel ja heleän eteerinen laulu eivät moisesta häiriinny, päinvastoin.</p>
        <p>Sinkkunakin julkaistu Alkuääni ja kiekon sulkeva Ikivirta ovat kaksi komeaa pylvästä, joiden välissä Palu kertoo mm. tarinan metsästäjästä, joka saa sydämeensä rauhan lämmön, sekä laulaa lähteneille ajattoman meren äärellä. Ei tähän osaisi enää lisätä mitään, poistamisesta nyt puhumattakaan ja kappalejärjestyskin on juuri oikean tuntuinen, joten täysi tähtipotti on ainoa vaihtoehto. Ja se suklaa on muuten todella hyvää.” <strong>–Mika Roth / Desibeli</strong></p>
      </div>
    </div>

    <div class="two-col" style="margin-top:3rem">
      <div>
        <h3>Awarded music video @ Oulu Music Video Festival</h3>
        <div class="embed"><iframe title="Awarded music video" src="https://www.youtube.com/embed/_xSWR4RVj2w" allowfullscreen loading="lazy"></iframe></div>
      </div>
      <div>
        <h3>Laulu Lähteneelle LIVE @ Rakkauden tila, Musiikkitalo</h3>
        <div class="embed"><iframe title="Laulu Lähteneelle live" src="https://www.youtube.com/embed/Glr-q0XYCME" allowfullscreen loading="lazy"></iframe></div>
      </div>
    </div>

    <hr class="divider" />

    <h2 class="center spaced">Film and media music</h2>
    <div class="two-col" style="margin-top:2rem">
      <div>
        <h3>VAISALA – Taking every measure for the planet</h3>
        <p>Sarah Palu: Ikivirta</p>
        <div class="embed"><iframe title="Vaisala" src="https://www.youtube.com/embed/lMz06jD9MsY" allowfullscreen loading="lazy"></iframe></div>
      </div>
      <div>
        <h3>HOMEBOUND – Awarded short film by Marika Harjusaari</h3>
        <p>Film score: Sarah Palu &amp; Matias Tyni</p>
        <a href="https://areena.yle.fi/1-4253754" rel="noopener"><img src={u("/images/screenshot-2020-04-13-at-10-40-12.png")} alt="Homebound on Yle Areena" width="743" height="379" loading="lazy" /></a>
        <p style="margin-top:1rem"><a class="btn" href="https://areena.yle.fi/1-4253754" rel="noopener">Watch on Yle Areena</a></p>
      </div>
    </div>

    <hr class="divider" />

    <h2 class="center spaced">Ensembles</h2>
    <div class="two-col" style="margin-top:2rem">
      <div>
        <h3>Viitasen Piia band on YLE Olohuone</h3>
        <a href="https://areena.yle.fi/1-50506030" rel="noopener"><img src={u("/images/img-0921.jpg")} alt="Viitasen Piia on YLE Olohuone" width="754" height="425" loading="lazy" /></a>
        <p style="margin-top:1rem"><a class="btn" href="https://areena.yle.fi/1-50506030" rel="noopener">Watch on Yle Areena</a></p>
      </div>
      <div>
        <h3>Viitasen Piia trio on SuomiLOVE / YLE</h3>
        <div class="yle_areena_player" data-id="1-4355071"></div>
        <script is:inline src="https://player-v2.yle.fi/embed.js" async></script>
      </div>
    </div>

    <div class="albums" style="margin-top:3rem">
      {albums.map(([artist, title, id]) => (
        <div class="spotify">
          <h4>{artist}<br /><em>{title}</em></h4>
          <iframe title={`${artist}: ${title}`} src={`https://open.spotify.com/embed/album/${id}?utm_source=generator&theme=0`} height="352" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>
      ))}
    </div>
  </section>
</Base>
